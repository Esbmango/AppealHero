# ---------- Gemini ----------
# Leave empty to run the deterministic fake agent (no network, no key) — useful for UI work and offline demos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CU_MODEL=gemini-3.8-flash
# auto = Gemini if GEMINI_API_KEY is set, otherwise fake
AI_MODE=auto

# ---------- Server ----------
PORT=4000
MOCK_PORTAL_URL=http://localhost:4100
# Set a long random string so approvals survive restarts; if empty a random secret is generated per boot.
APPROVAL_SECRET=
APPROVAL_TTL_MS=900000

# ---------- Executor ----------
# Fallback ladder for text fields: T1 = semantic locators (getByLabel), T2 = heuristic DOM match, T3 = Gemini Computer Use
# Default demo uses Playwright only. Select T1,T3 explicitly for a live Computer Use test.
EXEC_TIERS=T1,T2
# false = show a real Chrome window on the laptop during the demo
HEADLESS=true
# "chrome" uses an installed Google Chrome instead of `npm run browsers`
BROWSER_CHANNEL=
SLOW_MO_MS=0
SUBMIT_TIMEOUT_MS=8000
MASK_PII=false

# Cost meter (USD per 1M tokens). gemini-3.8-flash intro pricing is $0.75 / $3.75 through 2026-12-31.
PRICE_IN_PER_M=0.75
PRICE_OUT_PER_M=3.75

# ---------- Mock portal ----------
MOCK_PORTAL_PORT=4100
# how long the portal hangs in the submit-timeout scenarios (must exceed SUBMIT_TIMEOUT_MS)
MOCK_HANG_MS=30000

# Demo Mode gate: set this before exposing the app through a public tunnel; open the app once with ?key=<value>
DEMO_KEY=
